# ---------------------------------------------------------------------------
# Nexus production configuration for docker-compose.prod.yml.
# Copy to .env.prod on the server and fill in every <...> value. Never commit .env.prod.
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# ---------------------------------------------------------------------------

# LLM provider (Moonshot, OpenAI-compatible API)
MODEL_PROVIDER=moonshot
MODEL_NAME=kimi-k3
MODEL_API_BASE=https://api.moonshot.ai/v1
MODEL_API_KEY=<your-moonshot-key>
MODEL_REASONING_EFFORT=high

# Engine: start with mock to smoke-test the deployment, then switch to live.
NEXUS_ENGINE_MODE=mock
NEXUS_TASK_BACKEND=celery
NEXUS_MAX_QA_ITERATIONS=3
NEXUS_CELERY_QUEUE=nexus
# NEXUS_MONTHLY_GENERATION_QUOTA=25

# Django
DJANGO_SECRET_KEY=<long-random-string>
DJANGO_DEBUG=false
# localhost/127.0.0.1 keep the container health check and on-server curl tests working.
DJANGO_ALLOWED_HOSTS=nexus.praponb.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://nexus.praponb.com
CSRF_TRUSTED_ORIGINS=https://nexus.praponb.com

# Database (the `postgres` service; not published on the host)
DB_ENGINE=postgres
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=<long-random-string>
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis (the `redis` service; not published on the host)
REDIS_URL=redis://redis:6379/0
CHANNEL_LAYER=redis

# Generated workspaces, uploads and archives (the shared `media` volume)
NEXUS_MEDIA_ROOT=/app/media
