# ---------------------------------------------------------------------------
# Nexus environment configuration (copy to .env and fill in secrets)
# ---------------------------------------------------------------------------

# LLM provider (Moonshot, OpenAI-compatible API)
MODEL_PROVIDER=moonshot
MODEL_NAME=kimi-k3
MODEL_API_BASE=https://api.moonshot.ai/v1
MODEL_API_KEY=replace-me
MODEL_REASONING_EFFORT=high

# Engine: "live" runs the multi-agent pipeline against the LLM,
# "mock" replays a scripted run and emits a template app (no LLM calls).
NEXUS_ENGINE_MODE=live
# Task backend: "celery" (default, requires Redis) or "thread" (in-process, tests only)
NEXUS_TASK_BACKEND=celery
# Max QA self-correction iterations
NEXUS_MAX_QA_ITERATIONS=3
# Celery queue the API dispatches to and workers consume (start_dev.sh passes -Q)
NEXUS_CELERY_QUEUE=nexus
# Deterministic pre-QA checks: off | fast (layout + py_compile) | full (+ venv, manage.py check,
# makemigrations --check, migrate, npm install, nuxi build). Defaults: live=full, mock=fast.
# NEXUS_QA_CHECKS=full
# Per-agent turn timeout and model-API retry policy (fresh Agent per attempt, backoff 70s x 2^n)
# NEXUS_AGENT_TIMEOUT_SECONDS=2700
# NEXUS_RETRY_ATTEMPTS=4
# NEXUS_RETRY_BACKOFF_SECONDS=70
# Mock engine: seconds between scripted steps, and a deliberate syntax error to exercise self-correction
# NEXUS_MOCK_DELAY=0.12
# NEXUS_MOCK_INJECT_FAULT=0
# Monthly generation quota per user
# NEXUS_MONTHLY_GENERATION_QUOTA=25

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (docker-compose Postgres on host port 5433). Set DB_ENGINE=sqlite to use SQLite.
DB_ENGINE=postgres
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Redis (Channels layer + Celery broker). Set CHANNEL_LAYER=memory for single-process dev.
REDIS_URL=redis://localhost:6379/0
CHANNEL_LAYER=redis

# Frontend (Nuxt runtime config)
NUXT_PUBLIC_API_BASE=http://localhost:8000
NUXT_PUBLIC_WS_BASE=ws://localhost:8000
